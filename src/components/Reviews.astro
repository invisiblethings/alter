---
// Review wall on a dark band: colored cards, key sentence highlighted.
// `tags` shows reviews about the page's service first.
import Icon from './Icon.astro';
import ReviewCard from './ReviewCard.astro';
import { reviews as all, reviewsTagged, reviewStats, type ReviewTag } from '../data/reviews';
import { business } from '../data/business';
interface Props { limit?: number; title?: string; kicker?: string; bg?: string; offset?: number; tags?: ReviewTag[]; noLinks?: boolean; exclude?: RegExp }
const { limit = 6, title = 'What Staten Island homeowners say', kicker = `${reviewStats.average} stars · ${reviewStats.total} reviews`, offset = 0, tags, noLinks = false, exclude } = Astro.props;
const good = (r: (typeof all)[number]) => r.text.length > 90 && !(exclude && exclude.test(r.text));
const pool = (tags ? [...reviewsTagged(...tags).filter(good), ...all.filter(good)] : all.slice(offset).filter(good)).filter((r, i, a) => a.indexOf(r) === i);
const shown = pool.slice(0, Math.max(limit, 3));
const tones = ['gold', 'white', 'navy', 'white', 'ink', 'white'] as const;
const Score = noLinks ? 'div' : 'a';
---
<section class="sec rv-sec" aria-labelledby="rev-h">
  <div class="wrap">
    <div class="rv-head" data-reveal>
      <div><span class="kicker">{kicker}</span><h2 id="rev-h">{title}</h2></div>
      <Score class="rv-score" href={noLinks ? undefined : '/reviews/'}>
        <span class="rv-score-g"><Icon name="google" /></span>
        <b>{reviewStats.average}</b>
        <span><span class="rv-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span><small>{reviewStats.total} reviews · {reviewStats.bySource.Google} on Google{!noLinks && ' · read all →'}</small></span>
      </Score>
    </div>
    <div class="rv-grid">
      {shown.map((r, i) => <div data-reveal data-reveal-d={String(i % 3)}><ReviewCard r={r} tone={tones[i % tones.length]} max={i === 0 ? 0 : 340} big={i === 0} /></div>)}
    </div>
  </div>
</section>
