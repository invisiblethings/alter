---
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import { business } from '../data/business';
interface Props { limit?: number; title?: string; kicker?: string; bg?: string; grid?: boolean }
const { limit = 4, title = 'What Staten Island homeowners say', kicker = 'Google reviews', bg = '', grid = false } = Astro.props;
const [first, ...rest] = reviews;
const initials = (n: string) => n.split(' ').map((p) => p[0]).join('').slice(0, 2).toUpperCase();
const stars = [1, 2, 3, 4, 5];
---
<section class:list={['sec', bg]} aria-labelledby="rev-h">
  <div class="wrap">
    <div class="head-split" data-reveal>
      <div><span class="kicker">{kicker}</span><h2 id="rev-h">{title}</h2></div>
      <p><a class="btn btn-line" href="/reviews/">Read all reviews <Icon name="arrow" /></a></p>
    </div>
    {grid ? (
      <div class="reviews-cols">
        {reviews.slice(0, limit).map((r) => (
          <figure class="mini">
            <span class="stars" role="img" aria-label="5 out of 5 stars">{stars.map(() => <Icon name="star" />)}</span>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption><strong>{r.name}</strong> · Google review{r.tag && ` · ${r.tag}`}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="reviews-wrap">
        <figure class="bigquote" data-reveal>
          <span class="qmark" aria-hidden="true">“</span>
          <blockquote><p>{first.text}</p></blockquote>
          <figcaption><span class="avatar-s" aria-hidden="true">{initials(first.name)}</span><span><strong>{first.name}</strong><span class="stars" role="img" aria-label="5 out of 5 stars">{stars.map(() => <Icon name="star" />)}</span> Google review{first.tag && ` · ${first.tag}`}</span></figcaption>
        </figure>
        <div data-reveal data-reveal-d="1">
          <a class="score" href={business.googleReviewUrl} target="_blank" rel="noopener">
            <span class="g"><Icon name="google" /></span>
            <span><b>{business.rating.label}</b><small>{business.rating.count} reviews on Google Maps →</small></span>
          </a>
          <div class="mini-reviews">
            {rest.slice(0, Math.max(limit - 1, 0)).map((r) => (
              <figure class="mini">
                <span class="stars" role="img" aria-label="5 out of 5 stars">{stars.map(() => <Icon name="star" />)}</span>
                <blockquote><p>“{r.text.length > 190 ? r.text.slice(0, r.text.lastIndexOf(' ', 185)) + '…' : r.text}”</p></blockquote>
                <figcaption><strong>{r.name}</strong> · Google review</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</section>
