---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { business, telHref } from '../data/business';
import { services, areas, company, guides, legal } from '../data/nav';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <Image src={logo} alt="Alter Phase Roofing Contracting" width={150} />
      <p>Family-owned roofing contractor in Staten Island, NY. Roof repair, replacement and flat roofing across Staten Island, Brooklyn, Manhattan and Queens. Owner Marke is part of every job.</p>
      <a class="phone" href={telHref}>{business.phone}</a>
      <a href={`mailto:${business.email}`}>{business.email}</a>
      <div class="footer-badges">
        <span>GAF Master Elite®</span><span>BBB Accredited</span><span>Lic. #{business.license.number}</span>
      </div>
    </div>
    <div>
      <p class="h">Services</p>
      <ul>{services.flatMap((s) => [s, ...(s.children || []).slice(0, 1)]).map((s) => <li><a href={s.url}>{s.title}</a></li>)}</ul>
    </div>
    <div>
      <p class="h">Service areas</p>
      <ul>{areas.map((a) => <li><a href={a.url}>Roofing {a.title === 'All of NYC' ? 'NYC' : a.title}</a></li>)}</ul>
      <p class="h" style="margin-top:1.6rem">Company</p>
      <ul>{company.map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>
    </div>
    <div>
      <p class="h">Costs &amp; guides</p>
      <ul>{guides.map((g) => <li><a href={g.url}>{g.title}</a></li>)}<li><a href="/blog/">All guides</a></li></ul>
    </div>
    <div>
      <p class="h">Visit or call</p>
      <address style="font-style:normal"><a href={business.googleMapsUrl}>{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.zip}</a></address>
      <div class="hours" style="margin-top:1rem">
        {business.hours.map((h) => (<><span>{h.label}</span><span>{h.text}</span></>))}
        <span>Sun</span><span>Closed</span>
      </div>
      <p style="margin-top:0.8rem;color:var(--gold)"><strong>Emergencies: 24/7</strong></p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} {business.name} · NYC DCWP Home Improvement Contractor #{business.license.number}</span>
    <ul>
      {legal.map((l) => <li><a href={l.url}>{l.title}</a></li>)}
      <li><a href={business.social.facebook}>Facebook</a></li>
      <li><a href={business.social.yelp}>Yelp</a></li>
      <li><a href={business.social.linkedin}>LinkedIn</a></li>
    </ul>
  </div>
  <div class="wordmark" aria-hidden="true"><span>ALTER PHASE</span></div>
</footer>
