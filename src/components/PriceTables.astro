---
// Price cards rendered from src/data/costs.ts so every page quotes the same
// numbers (and Service schema matches what's visible).
import { materials, repairs, repairTiers, skylights, boroughs, money, range, COSTS_UPDATED } from '../data/costs';
import { fmtDate } from '../lib/content';
type Kind = 'repairs' | 'tiers' | 'flat' | 'pitched' | 'boroughs' | 'skylights';
// `only` limits the borough cards to one borough (single-borough ad landing pages).
interface Props { kinds: Kind[]; area?: string; only?: string }
const { kinds, area, only } = Astro.props;
const shownBoroughs = only ? boroughs.filter((b) => b.name === only) : boroughs;
const flat = materials.filter((m) => m.type === 'flat');
const pitched = materials.filter((m) => m.type === 'pitched');
const titles: Record<Kind, string> = {
  repairs: 'Roof repair prices',
  tiers: 'Repair cost by size of the job',
  skylights: 'Skylight prices',
  flat: 'New flat roof, installed',
  pitched: 'New asphalt shingle roof, installed',
  boroughs: 'Flat roof replacement by borough (≈1,000 sq ft)',
};
---
<div class="price-groups">
  {kinds.map((k) => (
    <div class="price-group">
      <h3>{k === 'boroughs' && only ? `New flat roof in ${only} (≈1,000 sq ft)` : titles[k]}{area && k !== 'boroughs' && area !== 'New York City' ? ` · ${area}` : ''}</h3>
      <div class="price-cards">
        {k === 'repairs' && repairs.map((r) => (
          <div class="pc"><span class="pc-name">{r.name}</span><span class="pc-val">{range(r.low, r.high)}</span></div>
        ))}
        {(k === 'tiers' || k === 'skylights') && (k === 'tiers' ? repairTiers : skylights).map((r) => (
          <div class="pc"><span class="pc-name">{r.name}</span><span class="pc-val">{range(r.low, r.high)}</span><span class="pc-note">{r.what}</span></div>
        ))}
        {(k === 'flat' || k === 'pitched') && (k === 'flat' ? flat : pitched).map((m) => (
          <div class="pc"><span class="pc-name">{m.name}</span><span class="pc-val">${m.low}–${m.high}<small>/sq ft</small></span><span class="pc-note">1,000 sq ft: {range(m.low * 1000, m.high * 1000)} · lasts {m.life}</span><span class="pc-tag">{m.bestFor}</span></div>
        ))}
        {k === 'boroughs' && shownBoroughs.map((b, i) => (
          <div class:list={['pc', i === 0 && 'pc-hl']}><span class="pc-name">{b.name}</span><span class="pc-val">{money(b.low)}–{money(b.high)}+</span><span class="pc-note">{b.drivers}</span></div>
        ))}
      </div>
    </div>
  ))}
  <p class="price-note">Alter Phase Roofing Contracting job averages, updated {fmtDate(COSTS_UPDATED)}. Your exact price comes from a free on-site inspection.</p>
</div>
