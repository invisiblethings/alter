---
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<section class:list={['section', dark ? 'section-navy' : 'section-sand']} aria-labelledby="process-title">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Simple, effective process</span>
      <h2 id="process-title">What happens after you call</h2>
      <p class:list={['lead', dark && 'muted']} style={dark ? 'color:#c9d4e8' : undefined}>No pushy salespeople, no surprises. The same four steps on every job.</p>
    </div>
    <ol class="steps">
      <li class="step"><h3>Roof inspection</h3><p>Schedule a no-obligation visit. We get on the roof, take photos, and find the real cause.</p></li>
      <li class="step"><h3>Customized solutions</h3><p>We review what we found with you and propose clear options: repair or replace, with prices in writing.</p></li>
      <li class="step"><h3>Quality execution</h3><p>Our own crew does the work, with Marke on site. We protect your property and clean up every day.</p></li>
      <li class="step"><h3>Enjoy peace of mind</h3><p>Final walkthrough, written warranty, and a follow-up check. Your roof is documented and protected.</p></li>
    </ol>
  </div>
</section>
