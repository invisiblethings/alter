---
// Visible FAQ. The same list feeds FAQPage schema, so markup always matches the page.
interface Props { items: { q: string; a: string }[]; title?: string; kicker?: string; id?: string }
const { items, title = 'Frequently asked questions', kicker = 'FAQ', id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq-sec" aria-labelledby={`${id}-h`} id={id}>
    <span class="kicker">{kicker}</span>
    <h2 id={`${id}-h`}>{title}</h2>
    <div class="faq">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary><h3>{f.q}</h3></summary>
          <div class="a"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </section>
)}
