---
// Every published review, filterable by job type. Plain HTML first: all
// cards render server-side (indexable), the filter only hides cards.
import Icon from './Icon.astro';
import ReviewCard from './ReviewCard.astro';
import { reviews, reviewStats, type ReviewTag } from '../data/reviews';
const filters: { t: ReviewTag | 'all'; label: string }[] = [
  { t: 'all', label: 'All reviews' },
  { t: 'replacement', label: 'Roof replacement' },
  { t: 'repair', label: 'Repairs & leaks' },
  { t: 'storm', label: 'Storm damage' },
  { t: 'gutters', label: 'Gutters' },
  { t: 'skylight', label: 'Skylights' },
  { t: 'flat', label: 'Flat roofs' },
  { t: 'honest', label: 'Honest advice' },
  { t: 'oneday', label: 'Done in one day' },
];
const count = (t: string) => (t === 'all' ? reviews.length : reviews.filter((r) => r.tags.includes(t as ReviewTag)).length);
---
<section class="sec rv-sec" aria-labelledby="wall-h" data-wall>
  <div class="wrap">
    <div class="head-split">
      <div><span class="kicker">{reviewStats.total} reviews · {reviewStats.average} stars</span><h2 id="wall-h">{reviews.length} written reviews, in our customers' own words</h2></div>
      <p class="muted">{reviewStats.bySource.Google} on Google · {reviewStats.bySource.Yelp} on Yelp · {reviewStats.bySource.HomeAdvisor} on HomeAdvisor · {reviewStats.bySource.Angi} on Angi · {reviewStats.bySource.BBB} on the BBB</p>
    </div>
    <div class="wall-filters" role="group" aria-label="Filter reviews">
      {filters.map((f, i) => <button type="button" data-f={f.t} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <span>{count(f.t)}</span></button>)}
    </div>
    <p class="sr-only" aria-live="polite" data-wall-status></p>
    <div class="reviews-cols">
      {reviews.map((r, i) => <ReviewCard r={r} tone={(['white', 'navy', 'white', 'gold', 'white', 'ink'] as const)[i % 6]} date />)}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-wall]').forEach((w) => {
    const btns = [...w.querySelectorAll<HTMLButtonElement>('[data-f]')];
    const cards = [...w.querySelectorAll<HTMLElement>('figure[data-tags]')];
    const status = w.querySelector('[data-wall-status]')!;
    btns.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.f!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      cards.forEach((c) => { const on = f === 'all' || c.dataset.tags!.split(' ').includes(f); c.hidden = !on; if (on) n++; });
      status.textContent = `${n} reviews shown`;
    }));
  });
</script>
