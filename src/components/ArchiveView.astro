---
import Base from '../layouts/Base.astro';
import Skyline from './Skyline.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaBand from './CtaBand.astro';
import { getEntry } from 'astro:content';
import { posts, excerpt, crumbsFor } from '../lib/content';
import { pageGraph } from '../lib/schema';

interface Props { id: string; category?: number; intro: string }
const { id, category, intro } = Astro.props;
const page = (await getEntry('pages', id))!.data;
const list = (await posts()).filter((p) => !category || p.data.categories.includes(category));
const crumbs = await crumbsFor(page.path, page.h1);
const fmt = (s?: string) => (s ? new Date(s + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '');
const schema = pageGraph({ url: page.path, title: page.seoTitle, description: page.description, crumbs, kind: 'collection', h1: page.h1 });
---
<Base title={page.seoTitle} description={page.description} path={page.path} schema={schema} noindex={page.noindex}>
  <section class="page-hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:820px">
        <Breadcrumbs crumbs={crumbs} />
        <h1>{page.h1}</h1>
        <p class="lead">{intro}</p>
      </div>
    </div>
    <Skyline />
  </section>
  <section class="section">
    <div class="wrap">
      <div class="post-grid">
        {list.map((p) => (
          <a class="post-card" href={p.data.path}>
            {p.data.image && <img src={p.data.image} alt={p.data.imageAlt || ''} width="600" height="375" loading="lazy" decoding="async" />}
            <div class="post-card-body">
              <time datetime={p.data.published}>{fmt(p.data.published)}</time>
              <h2 style="font-size:1.2rem;margin:0">{p.data.h1}</h2>
              <p>{excerpt(p.body || '', 24)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
