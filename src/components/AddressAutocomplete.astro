---
// Address suggestions for every input marked data-places.
// Source: NYC Planning Labs GeoSearch (free, no key, official NYC address
// data for all five boroughs): https://geosearch.planninglabs.nyc
// Addresses outside the suggestions can always be typed freely.
---
<script is:inline>
  (function () {
    var inputs = document.querySelectorAll('input[data-places]');
    if (!inputs.length) return;

    // "61 APPLEBY AVENUE, Staten Island, NY, USA" + 10305 -> "61 Appleby Avenue, Staten Island, NY 10305"
    var title = function (s) { return s.toLowerCase().replace(/\b([a-z])/g, function (m) { return m.toUpperCase(); }); };
    function nyc(q) {
      return fetch('https://geosearch.planninglabs.nyc/v2/autocomplete?text=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var seen = {};
          return (d.features || []).map(function (f) {
            var p = f.properties || {};
            if (!p.name || / (REAR|GARAGE|FRONT)\b/.test(p.name)) return null;
            return title(p.name) + ', ' + (p.borough || p.locality || 'New York') + ', NY' + (p.postalcode ? ' ' + p.postalcode : '');
          }).filter(function (t) { if (!t || seen[t]) return false; seen[t] = 1; return true; }).slice(0, 5);
        });
    }

    var n = 0;
    inputs.forEach(function (input) {
      var id = 'apr-addr-' + (++n), list = document.createElement('ul'), items = [], active = -1, timer, seq = 0;
      list.id = id; list.className = 'addr-list'; list.setAttribute('role', 'listbox'); list.hidden = true;
      input.parentNode.style.position = 'relative';
      input.parentNode.appendChild(list);
      input.setAttribute('role', 'combobox'); input.setAttribute('aria-autocomplete', 'list'); input.setAttribute('aria-expanded', 'false'); input.setAttribute('aria-controls', id);
      input.setAttribute('autocomplete', 'off');
      function close() { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; }
      function pick(i) { if (!items[i]) return; input.value = items[i]; close(); input.dispatchEvent(new Event('change', { bubbles: true })); }
      function mark(i) {
        active = i;
        [].forEach.call(list.children, function (li, k) { li.setAttribute('aria-selected', String(k === i)); });
        if (i >= 0) input.setAttribute('aria-activedescendant', id + '-' + i); else input.removeAttribute('aria-activedescendant');
      }
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (q.length < 3 || /^\d{1,5}$/.test(q)) { close(); return; }
        var mine = ++seq;
        timer = setTimeout(function () {
          nyc(q).then(function (res) {
            if (mine !== seq) return; // a newer keystroke is already on its way
            items = res;
            list.innerHTML = '';
            items.forEach(function (t, i) {
              var li = document.createElement('li'); li.id = id + '-' + i; li.setAttribute('role', 'option'); li.textContent = t;
              li.addEventListener('mousedown', function (e) { e.preventDefault(); pick(i); });
              list.appendChild(li);
            });
            if (items.length) { list.hidden = false; input.setAttribute('aria-expanded', 'true'); mark(-1); } else close();
          }).catch(close);
        }, 200);
      });
      input.addEventListener('keydown', function (e) {
        if (list.hidden) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); mark(Math.min(active + 1, items.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); mark(Math.max(active - 1, 0)); }
        else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); pick(active); }
        else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); } // don't also close a popup form
      });
      input.addEventListener('blur', function () { setTimeout(close, 120); });
    });
  })();
</script>
