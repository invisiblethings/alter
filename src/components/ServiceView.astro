---
// Service, area and hub pages: photo hero with the quote form, a short-answer
// band, the page content as designed sections, real prices, proof and a
// closing form. Built to read like a landing page, not an article.
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import QuoteWizard from './QuoteWizard.astro';
import PriceTables from './PriceTables.astro';
import ContentSections from './ContentSections.astro';
import Process from './Process.astro';
import Reviews from './Reviews.astro';
import type { ReviewTag } from '../data/reviews';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Estimator from './Estimator.astro';
import { business, telHref } from '../data/business';
import { allLinks } from '../data/nav';
import { allEntries, type PageEntry } from '../lib/content';

interface Props { entry: PageEntry; html: string; crumbs: { name: string; url: string }[] }
const { entry, html, crumbs } = Astro.props;
const d = entry.data;

const entries = await allEntries();
const related = d.related.map((u) => {
  const e = entries.find((x) => x.data.path === u);
  return { url: u, title: allLinks().find((l) => l.url === u)?.title || ('cardTitle' in (e?.data || {}) && (e!.data as any).cardTitle) || e?.data.h1 || u, img: e?.data.image, guide: e?.data.template === 'post' };
});
// Show reviews about this kind of job first.
const p = d.path;
const reviewTags: ReviewTag[] | undefined =
  p.includes('emergency') ? ['storm', 'leak']
  : p.includes('skylight') ? ['skylight']
  : p.includes('gutter') || p.includes('siding') ? ['gutters']
  : p.includes('flat-roofing') ? ['flat', 'leak']
  : p.includes('property-managers') || p.includes('commercial') ? ['property', 'repair']
  : p.includes('roof-repair') ? ['repair', 'leak', 'honest']
  : p.includes('replacement') ? ['replacement', 'oneday']
  : p.includes('inspection') ? ['honest', 'repair']
  : undefined;
const isRepair = /repair|emergency/.test(p);
const facts = [
  { i: 'camera', t: 'Free inspection with photos', s: 'You see exactly what we see' },
  { i: 'file', t: 'Written price in 24 hours', s: 'Itemized, no pressure' },
  isRepair
    ? { i: 'bolt', t: 'Emergency calls 24/7', s: 'We stop the water first' }
    : { i: 'calendar', t: 'Most roofs done in 1 day', s: 'Tear-off to cleanup' },
  { i: 'shield', t: `Up to ${business.warranty.manufacturerYears}-yr warranty`, s: `Plus ${business.warranty.workmanshipYears} yrs on workmanship` },
];
const service = d.service || d.h1.split(':')[0];
---
<section class="hero">
  <div class="hero-bg"><img src={d.image || '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-15.jpg'} alt={d.imageAlt || ''} width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /></div>
  <div class="wrap">
    <div>
      <Breadcrumbs crumbs={crumbs} />
      {d.kicker && <span class="kicker">{d.kicker}</span>}
      <h1>{d.h1}</h1>
      {d.intro && <p class="lead">{d.intro}</p>}
      {d.highlights.length > 0 && <ul class="ticks" style="margin-top:1.5rem">{d.highlights.map((h) => <li><Icon name="check" /> <span set:html={h} /></li>)}</ul>}
      <div class="cta-row">
        <a class="btn btn-lg btn-gold btn-call" href={telHref}><Icon name="phone" /><span><small>Call or text · 24/7</small>{business.phone}</span></a>
      </div>
      <ul class="hero-proof">
        <li><span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span><span><strong>{business.rating.value}</strong> from {business.rating.count} reviews</span></li>
        <li><Icon name="award" /><span>GAF Certified</span></li>
        <li><Icon name="license" /><span>Lic. <strong>#{business.license.number}</strong></span></li>
      </ul>
    </div>
    <QuoteWizard id="pg" service={d.wizard} />
  </div>
</section>

<section class="answer-band" aria-label="The short answer">
  <div class="wrap">
    {d.answer && (
      <div class="ab-answer" data-reveal>
        <span class="ab-k"><Icon name="bolt" /> The short answer</span>
        <p set:html={d.answer} />
      </div>
    )}
    <ul class="ab-facts" data-reveal data-reveal-d="1">
      {facts.map((f) => <li><span class="ab-ico"><Icon name={f.i as any} /></span><span><strong>{f.t}</strong>{f.s}</span></li>)}
    </ul>
  </div>
</section>

<ContentSections html={html} />

{(d.prices.length > 0 || d.estimator) && (
  <section class="sec dark price-sec" id="prices" aria-labelledby="prices-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Real prices, not "call for a quote"</span><h2 id="prices-h">What {service.toLowerCase()} costs{d.area && d.area !== 'New York City' ? ` ${d.area === 'Staten Island' ? 'on' : 'in'} ${d.area}` : ''}</h2></div>
        <p class="lead">Averages from our own jobs. Your exact price comes in writing after a free inspection.</p>
      </div>
      {d.prices.length > 0 && <div data-reveal><PriceTables kinds={d.prices} area={d.area} /></div>}
      {d.estimator && <div id="Roof_Replacement_Cost_Calculator" style="margin-top:2.5rem" data-reveal><Estimator heading="h3" home={d.prices.includes('flat') && !d.prices.includes('pitched') ? 'flat' : 'detached'} /></div>}
    </div>
  </section>
)}

{d.projects.length > 0 && (
  <section class="sec" aria-labelledby="pj-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Recent work</span><h2 id="pj-h">Recent projects{d.area ? ` in ${d.area}` : ''}</h2></div>
        <p class="lead">Our own crew on our own jobs. No stock photos.</p>
      </div>
      <div class="mosaic">
        {d.projects.map((pr) => (
          <figure data-reveal><img src={pr.image} alt={`${pr.title}, ${pr.location}`} width="600" height="750" loading="lazy" decoding="async" /><figcaption><h3>{pr.title}</h3>{pr.location}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>
)}

<Process />
<Reviews limit={6} tags={reviewTags} title={d.area && d.area !== 'New York City' ? `What ${d.area} customers say` : 'What our customers say'} />

{d.faq.length > 0 && (
  <section class="sec bone">
    <div class="wrap faq-split">
      <div data-reveal>
        <span class="kicker">FAQ</span>
        <h2>{service}: your questions, answered</h2>
        <p class="lead">Don't see yours? Call or text and you'll talk to someone who actually works on roofs.</p>
        <a class="btn btn-lg" href={telHref}><Icon name="phone" /> {business.phone}</a>
      </div>
      <div data-reveal data-reveal-d="1"><Faq items={d.faq} title={`${service}: common questions`} bare /></div>
    </div>
  </section>
)}

{related.length > 0 && (
  <nav class="sec related-sec" aria-labelledby="rel-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Keep exploring</span><h2 id="rel-h">Related services and guides</h2></div>
      </div>
      <div class="rel-grid">
        {related.map((r) => (
          <a class="rel" href={r.url} data-reveal>
            {r.img ? <img src={r.img} alt="" width="400" height="260" loading="lazy" decoding="async" /> : <span class="rel-ph"><Icon name="roof" /></span>}
            <span class="rel-b"><em>{r.guide ? 'Guide' : 'Service'}</em><strong>{r.title}</strong><span class="link-arrow">Learn more <Icon name="arrow" /></span></span>
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<FinalCta service={d.wizard} />
{d.trackingPhone && (
  <script is:inline define:vars={{ shown: d.trackingPhone, digits: d.trackingPhone.replace(/\D/g, '') }}>
    // Ads landing page: show the campaign's tracking number everywhere.
    document.querySelectorAll('a[href^="tel:"]').forEach(function (a) { a.href = 'tel:+1' + digits; });
    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    while (w.nextNode()) { if (w.currentNode.nodeValue.indexOf('(929) 370-1552') > -1) w.currentNode.nodeValue = w.currentNode.nodeValue.split('(929) 370-1552').join(shown); }
  </script>
)}
