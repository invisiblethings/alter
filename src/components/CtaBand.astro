---
import Icon from './Icon.astro';
import Skyline from './Skyline.astro';
import EstimateForm from './EstimateForm.astro';
import { business, telHref } from '../data/business';
interface Props { title?: string; text?: string; withForm?: boolean }
const { title = 'Worried about your roof? Let’s take a look.', text = 'Free inspection and written estimate. We get on the roof, walk you through what we find, with photos, and give you honest options. Even when the answer is “it just needs a repair.”', withForm = true } = Astro.props;
---
<section class="cta-band" aria-labelledby="cta-title">
  <div class="wrap">
    <div>
      <span class="eyebrow">Free estimate</span>
      <h2 id="cta-title">{title}</h2>
      <p class="lead" style="color:#cdd7ea">{text}</p>
      <p style="margin:1.5rem 0 0.25rem;color:#cdd7ea">Call or text, 7 days a week for emergencies</p>
      <a class="phone-big" style="color:var(--gold-400);font-size:2.2rem" href={telHref}>{business.phone}</a>
      <ul class="hero-proof" style="margin-top:1.25rem">
        <li><Icon name="check" /> Same-day visits when possible</li>
        <li><Icon name="check" /> Written warranties</li>
        <li><Icon name="check" /> Permits handled</li>
      </ul>
    </div>
    {withForm ? <EstimateForm idPrefix="cta" compact heading="h3" /> : (
      <div><a class="btn btn-gold btn-lg" href="/free-estimate/">Get my free estimate <Icon name="arrow" /></a></div>
    )}
  </div>
  <Skyline class="skyline-bg" />
</section>
