---
// Scrolling credential band. Duplicated once so the CSS loop is seamless;
// the copy is aria-hidden so screen readers hear it once.
import { business } from '../data/business';
const items = [
  `${business.rating.label} on Google · ${business.rating.count} reviews`,
  'GAF Master Elite® contractor',
  'BBB Accredited',
  `Up to ${business.warranty.manufacturerYears}-year warranties`,
  `NYC licensed #${business.license.number}`,
  'Family-owned on Staten Island',
  'Emergency calls 24/7',
  'Staten Island · Brooklyn · Manhattan · Queens',
];
---
<section class="marquee" aria-label="Credentials">
  <div class="marquee-track">
    <ul style="display:contents;list-style:none">{items.map((t) => <li style="display:contents"><span>{t}</span></li>)}</ul>
    <span style="display:contents" aria-hidden="true">{items.map((t) => <span>{t}</span>)}</span>
  </div>
</section>
