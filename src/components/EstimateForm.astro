---
// Netlify Forms. Works without JavaScript (posts to /thank-you/); with JS it
// submits in place and pushes a `generate_lead` event for GTM / Google Ads.
import Icon from './Icon.astro';
import { business, telHref } from '../data/business';
interface Props { title?: string; subtitle?: string; idPrefix?: string; compact?: boolean; heading?: 'h2' | 'h3' }
const { title = 'Get a free inspection & estimate', subtitle = 'Three quick fields. We call you back, usually within the hour.', idPrefix = 'f', compact = false, heading = 'h2' } = Astro.props;
const H = heading;
const page = Astro.url.pathname;
---
<div class="form-card" id="estimate">
  <H>{title}</H>
  <p>{subtitle}</p>
  <form name="estimate" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-estimate-form>
    <input type="hidden" name="form-name" value="estimate" />
    <input type="hidden" name="page" value={page} />
    <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <div class="field-row">
      <div class="field">
        <label for={`${idPrefix}-name`}>Your name</label>
        <input id={`${idPrefix}-name`} name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for={`${idPrefix}-phone`}>Phone</label>
        <input id={`${idPrefix}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      </div>
    </div>
    <div class="field">
      <label for={`${idPrefix}-address`}>Property address or ZIP</label>
      <input id={`${idPrefix}-address`} name="address" autocomplete="street-address" required />
    </div>
    <fieldset class="field" style="border:0;padding:0;margin:0 0 0.95rem">
      <legend class="field-legend" style="font-weight:700;font-size:0.92rem;color:var(--navy-900);margin-bottom:0.4rem">This is for <span style="font-weight:400;color:var(--muted)">(optional)</span></legend>
      <div class="choice">
        <label><input type="radio" name="customer_type" value="Homeowner" /><span>My home</span></label>
        <label><input type="radio" name="customer_type" value="Business" /><span>My business</span></label>
        <label><input type="radio" name="customer_type" value="Property manager / HOA" /><span>A building I manage</span></label>
      </div>
    </fieldset>
    {!compact && (
      <div class="field">
        <label for={`${idPrefix}-msg`}>What's going on? <span>(optional)</span></label>
        <textarea id={`${idPrefix}-msg`} name="message" rows="3" placeholder="e.g. leak over the bedroom after the last storm"></textarea>
      </div>
    )}
    <button class="btn btn-gold btn-block btn-lg" type="submit">Request my free estimate <Icon name="arrow" /></button>
    <p class="form-note"><Icon name="lock" /> No spam, no pressure. We never share your details.</p>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
  <div class="form-after">
    <ol>
      <li><span><strong>We call you</strong> to hear what's going on and book a visit.</span></li>
      <li><span><strong>We inspect your roof in person</strong> and take photos. Marke is part of every job.</span></li>
      <li><span><strong>You get a written quote</strong> with clear options. No pressure.</span></li>
    </ol>
    <p class="form-note">Prefer to talk? <a href={telHref}><strong>{business.phone}</strong></a></p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-estimate-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.form-status')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        (window as any).dataLayer?.push({ event: 'generate_lead', form_name: 'estimate', page_path: location.pathname });
        location.href = '/thank-you/';
      } catch {
        btn.disabled = false;
        status.textContent = 'Sorry, that did not go through. Please call us at (929) 370-1552.';
      }
    });
  });
</script>
