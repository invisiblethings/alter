---
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Reviews from './Reviews.astro';
import ReviewWall from './ReviewWall.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import ContentSections from './ContentSections.astro';
import { business, telHref } from '../data/business';
import type { PageEntry } from '../lib/content';
interface Props { entry: PageEntry; html: string; crumbs: { name: string; url: string }[] }
const { entry, html, crumbs } = Astro.props;
const d = entry.data;
const legal = d.template === 'legal';
---
<section class:list={[d.image && !legal ? 'hero' : 'ghero']}>
  {d.image && !legal && <div class="hero-bg"><img src={d.image} alt={d.imageAlt || ''} width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /></div>}
  <div class="wrap" style={d.image && !legal ? 'grid-template-columns:minmax(0,1fr)' : undefined}>
    <div style="max-width:52rem">
      <Breadcrumbs crumbs={crumbs} />
      {d.kicker && <span class="kicker">{d.kicker}</span>}
      <h1>{d.h1}</h1>
      {d.intro && <p class="lead">{d.intro}</p>}
      {!legal && (
        <div class="cta-row" style="margin-top:1.75rem">
          <a class="btn btn-lg btn-gold btn-call" href={telHref}><Icon name="phone" /><span><small>Call or text</small>{business.phone}</span></a>
          <a class="btn btn-lg btn-ghost" href="/free-estimate/">Get a free estimate <Icon name="arrow" /></a>
        </div>
      )}
    </div>
  </div>
</section>
{legal ? (
  <section class="sec" style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="narrow">
      <div class="prose" set:html={html} />
    </div>
  </section>
) : (
  <>
    {d.answer && (
      <section class="answer-band" aria-label="The short answer">
        <div class="wrap">
          <div class="ab-answer" data-reveal><span class="ab-k"><Icon name="bolt" /> The short answer</span><p set:html={d.answer} /></div>
          <ul class="ab-facts" data-reveal data-reveal-d="1">
            <li><span class="ab-ico"><Icon name="users" /></span><span><strong>Family-owned</strong>{business.yearsInRoofing}+ years in roofing</span></li>
            <li><span class="ab-ico"><Icon name="star" /></span><span><strong>{business.rating.value} stars</strong>{business.rating.count} reviews</span></li>
            <li><span class="ab-ico"><Icon name="award" /></span><span><strong>GAF Master Elite®</strong>BBB Accredited</span></li>
            <li><span class="ab-ico"><Icon name="license" /></span><span><strong>Licensed &amp; insured</strong>#{business.license.number}</span></li>
          </ul>
        </div>
      </section>
    )}
    <ContentSections html={html} formHref="/free-estimate/" cta={d.template !== 'reviews'} />
    {d.faq.length > 0 && (
      <section class="sec">
        <div class="wrap faq-split">
          <div data-reveal><span class="kicker">FAQ</span><h2>Questions we get asked</h2><a class="btn btn-lg" href={telHref}><Icon name="phone" /> {business.phone}</a></div>
          <div data-reveal data-reveal-d="1"><Faq items={d.faq} bare /></div>
        </div>
      </section>
    )}
  </>
)}
{d.template === 'reviews' && <ReviewWall />}
{d.template === 'company' && <Process bg="" />}
{d.template === 'company' && <Reviews limit={4} bg="" />}
{!legal && <FinalCta />}
