---
// Job application form for /careers/ (Netlify form "job-application").
// Sent with fetch and confirmed in place: applications must not go to the
// thank-you page, which counts a Google Ads lead conversion.
import Icon from './Icon.astro';
import { business, telHref } from '../data/business';
const positions = ['Experienced roofer', 'Roofing helper / laborer', 'Crew lead / foreman', 'Other'];
const skills = ['Asphalt shingles', 'Flat roofing (EPDM, TPO, mod-bit)', 'Flashing & chimneys', 'Gutters & siding', 'Driver\'s license', 'OSHA 10 / 30 card'];
---
<section class="sec bone" id="apply" aria-labelledby="apply-h">
  <div class="wrap ja-wrap">
    <div class="ja-intro" data-reveal>
      <span class="kicker">Apply now</span>
      <h2 id="apply-h">Join the crew</h2>
      <p class="lead">Tell us a little about yourself. It takes two minutes, no resume needed. We'll call you back.</p>
      <ul class="ticks">
        <li><Icon name="check" /> Experienced roofers and new helpers welcome</li>
        <li><Icon name="check" /> Training on the job</li>
        <li><Icon name="check" /> Work across Staten Island and NYC</li>
      </ul>
      <p class="ja-alt">Rather talk? Call <a href={telHref}>{business.phone}</a> or email <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
    </div>
    <form class="ja-form" name="job-application" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-ja>
      <input type="hidden" name="form-name" value="job-application" />
      <p class="hp"><label>Leave empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="row-2">
        <div class="field"><label for="ja-name">Full name</label><input id="ja-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="ja-phone">Phone</label><input id="ja-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></div>
      </div>
      <div class="field"><label for="ja-email">Email <small>(optional)</small></label><input id="ja-email" name="email" type="email" autocomplete="email" /></div>
      <fieldset class="ja-set">
        <legend>Position</legend>
        <div class="ja-pick">
          {positions.map((p, i) => <label><input type="radio" name="position" value={p} required checked={i === 0} /><span>{p}</span></label>)}
        </div>
      </fieldset>
      <div class="field">
        <label for="ja-exp">Years of roofing experience</label>
        <select id="ja-exp" name="experience" required>
          <option value="">Choose one</option>
          <option>None, I want to learn</option><option>Less than 1 year</option><option>1–3 years</option><option>3–5 years</option><option>5+ years</option>
        </select>
      </div>
      <fieldset class="ja-set">
        <legend>Skills & certifications <small>(check all that apply)</small></legend>
        <div class="ja-checks">
          {skills.map((s) => <label><input type="checkbox" name="skills" value={s} /><span>{s}</span></label>)}
        </div>
      </fieldset>
      <div class="field"><label for="ja-msg">Anything else? <small>(optional)</small></label><textarea id="ja-msg" name="message" rows="3" placeholder="Past companies, what you're good at, when you can start"></textarea></div>
      <button class="btn btn-gold btn-lg btn-block" type="submit" data-submit>Send my application <Icon name="arrow" /></button>
      <p class="form-status" role="alert"></p>
      <div class="ja-done" hidden tabindex="-1">
        <Icon name="check" />
        <div><strong>Thanks, your application was sent.</strong><p>We'll call you within a few days. Questions in the meantime? Call {business.phone}.</p></div>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-ja]').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = f.querySelector('.form-status')!;
      const btn = f.querySelector<HTMLButtonElement>('[data-submit]')!;
      btn.disabled = true; status.textContent = '';
      // Several skills can be checked: join them into one field for the email.
      const fd = new FormData(f);
      const skills = fd.getAll('skills').join(', ');
      fd.delete('skills'); fd.set('skills', skills);
      try {
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(fd as any).toString() });
        if (!res.ok) throw new Error(String(res.status));
        f.querySelectorAll<HTMLElement>(':scope > :not(.ja-done)').forEach((el) => (el.hidden = true));
        const done = f.querySelector<HTMLElement>('.ja-done')!;
        done.hidden = false; done.focus();
        (window as any).dataLayer?.push({ event: 'job_application' });
      } catch {
        btn.disabled = false;
        status.textContent = 'Sorry, that didn’t go through. Please call or email us instead.';
      }
    });
  });
</script>

<style>
  .ja-wrap { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .ja-intro { position: sticky; top: calc(var(--head) + 24px); }
  .ja-intro h2 { margin: 0.3rem 0 0.8rem; }
  .ja-alt { margin-top: 1.25rem; color: var(--muted); }
  .ja-form { background: #fff; border-radius: var(--r-lg); box-shadow: var(--sh); padding: clamp(1.3rem, 3vw, 2.2rem); display: grid; gap: 1rem; }
  .ja-form .field { margin: 0; }
  .ja-set { border: 0; margin: 0; padding: 0; min-width: 0; }
  .ja-set legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.55rem; padding: 0; }
  .ja-set small, .ja-form label small { color: var(--muted); font-weight: 500; }
  .ja-pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .ja-checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.45rem 1rem; }
  .ja-pick label, .ja-checks label { cursor: pointer; }
  .ja-pick input { position: absolute; opacity: 0; pointer-events: none; }
  .ja-pick span { display: block; padding: 0.75rem 0.9rem; border: 1.5px solid var(--line); border-radius: 12px; font-weight: 700; font-size: 0.93rem; transition: all 0.15s; }
  .ja-pick label:hover span { border-color: var(--navy-2); }
  .ja-pick input:checked + span { background: var(--navy); border-color: var(--navy); color: #fff; }
  .ja-pick input:focus-visible + span { outline: 3px solid var(--gold-2); outline-offset: 2px; }
  .ja-checks label { display: flex; gap: 0.55rem; align-items: center; font-size: 0.93rem; }
  .ja-checks input { width: 18px; height: 18px; accent-color: var(--navy); flex: none; }
  .ja-done { display: flex; gap: 0.9rem; align-items: flex-start; padding: 1.2rem; border-radius: var(--r); background: #f0faf5; border: 2px solid #6cc79b; }
  .ja-done[hidden] { display: none; }
  .ja-done :global(.icon) { width: 28px; height: 28px; color: var(--green); flex: none; }
  .ja-done p { margin: 0.25rem 0 0; color: var(--muted); }
  @media (max-width: 860px) { .ja-wrap { grid-template-columns: minmax(0, 1fr); } .ja-intro { position: static; } }
  @media (max-width: 480px) { .ja-pick, .ja-checks { grid-template-columns: minmax(0, 1fr); } }
</style>
