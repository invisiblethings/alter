---
import Icon from './Icon.astro';
import { business } from '../data/business';
---
<section class="trust" aria-label="Why homeowners trust us">
  <div class="wrap">
    <ul class="trust-grid" style="list-style:none;margin:0;padding:0">
      <li class="trust-item"><Icon name="star" /><div><strong>{business.rating.count} Google reviews</strong><span>Rated “{business.rating.label}” by neighbors</span></div></li>
      <li class="trust-item"><Icon name="award" /><div><strong>GAF Master Elite®</strong><span>Factory-certified installer</span></div></li>
      <li class="trust-item"><Icon name="shield" /><div><strong>Up to {business.warranty.manufacturerYears}-yr warranty</strong><span>Plus up to {business.warranty.workmanshipYears} years on workmanship</span></div></li>
      <li class="trust-item"><Icon name="license" /><div><strong>Licensed &amp; insured</strong><span>NYC DCWP #{business.license.number}</span></div></li>
    </ul>
  </div>
</section>
