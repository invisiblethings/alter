---
// New page (no WordPress equivalent): the "A building I manage" door from the
// homepage. Built for HOAs, co-op/condo boards and property managers.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Skyline from '../components/Skyline.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, telHref } from '../data/business';
import { pageGraph } from '../lib/schema';

const path = '/property-managers/';
const title = 'Roofing for Property Managers, HOAs & Co-op Boards in NYC | Alter Phase Roofing';
const description = 'Roof inspections, repairs and replacements for property managers, HOAs, co-op and condo boards across Staten Island, Brooklyn, Manhattan and Queens. Written proposals, photo reports, 24/7 emergency response.';
const h1 = 'Roofing for property managers, HOAs and co-op boards';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Property Managers', url: path }];
const faq = [
  { q: 'Can you provide a certificate of insurance before work starts?', a: 'Yes. We are licensed and insured, and we provide a certificate of insurance on request, before any work begins, so your management company or board has it on file.' },
  { q: 'Do you bid on multiple buildings at once?', a: 'Yes. Send us the addresses and what you know about each roof. We inspect each building and give you a separate written scope and price for each one, so you can compare and schedule them.' },
  { q: 'Who handles NYC Department of Buildings permits?', a: 'We do. When a job needs a DOB permit, we handle the filing, and permit costs are included in the written estimate.' },
  { q: 'How do you handle emergencies at a managed building?', a: `Call ${business.phone}. Emergency calls are answered 24/7. We stop the water first, with tarping or a temporary repair, document the damage with photos, then quote the permanent repair.` },
  { q: 'How often should a building roof be inspected?', a: 'Twice a year is a good rule for flat roofs in NYC: once in spring to check winter damage and once in fall before the cold season. Catching small issues early is far cheaper than an emergency repair.' },
];
const schema = pageGraph({ url: path, title, description, crumbs, kind: 'service', h1, serviceArea: 'New York City', faq });
const offers = [
  { icon: 'file', t: 'Board-ready written proposals', d: 'Scope, materials, schedule, warranty and price on paper, with photos of what we found. Easy to share with owners or a board.' },
  { icon: 'camera', t: 'Photo inspection reports', d: 'Condition, problem areas and recommended next steps for each roof, so you can plan budgets instead of reacting to leaks.' },
  { icon: 'building', t: 'Multi-building bids', d: 'One point of contact for your whole portfolio, with a separate scope and price per address.' },
  { icon: 'shield', t: 'Insurance & license on file', d: `Certificate of insurance on request. NYC DCWP Home Improvement Contractor #${business.license.number}.` },
  { icon: 'bolt', t: '24/7 emergency response', d: 'Active leak at a tenant’s unit? We answer around the clock and make the roof watertight first.' },
  { icon: 'calendar', t: 'Scheduled around your tenants', d: 'We plan noisy work and access with you in advance, protect common areas, and clean up every day.' },
];
---
<Base title={title} description={description} path={path} schema={schema}>
  <section class="page-hero has-form">
    <div class="wrap">
      <div>
        <Breadcrumbs crumbs={crumbs} />
        <span class="eyebrow" style="color:var(--gold-400)">HOAs · Co-ops · Condos · Property managers</span>
        <h1>{h1}</h1>
        <p class="lead">You manage the building, we take care of the roof. Inspections, repairs and full replacements across Staten Island, Brooklyn, Manhattan and Queens, documented properly for owners and boards.</p>
        <div class="hero-actions"><a class="btn btn-gold btn-lg" href={telHref}><Icon name="phone" /> Call {business.phone}</a></div>
        <ul class="hero-mini-proof">
          <li><Icon name="license" /> Licensed &amp; insured</li>
          <li><Icon name="award" /> GAF Master Elite®</li>
          <li><Icon name="shield" /> Written warranties</li>
        </ul>
      </div>
      <EstimateForm idPrefix="pm" title="Request a proposal or bid" subtitle="Tell us the address (or addresses) and what's going on. We'll set up inspections." heading="h2" />
    </div>
    <Skyline />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What you get</span>
        <h2>Everything a board or owner will ask you for</h2>
        <p class="lead">Managing a building means answering to residents, owners and boards. We make the roofing part easy to explain and easy to approve.</p>
      </div>
      <div class="card-grid">
        {offers.map((o) => (
          <div class="card"><h3 style="display:flex;gap:0.5rem;align-items:center"><Icon name={o.icon as any} class="" />{o.t}</h3><p>{o.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sand">
    <div class="wrap split">
      <div class="prose">
        <span class="eyebrow">NYC rules, handled</span>
        <h2>Permits and compliance, explained before work starts</h2>
        <p>Roof work in New York City can involve Department of Buildings permits, and larger jobs can trigger the city's energy and sustainable roofing rules, such as cool-roof requirements and Local Laws 92 and 94 of 2019 when an entire roof deck is replaced.</p>
        <p>We tell you which requirements apply to your building before you approve anything, handle the permit filing when one is needed, and include permit costs in the written estimate.</p>
        <p><a href="/roof-replacement-guide-nyc/">Read our NYC roof replacement guide (permits, costs &amp; contractors)</a></p>
      </div>
      <div class="prose">
        <h2>Roof systems we install and repair</h2>
        <ul>
          <li><a href="/flat-roofing/">Flat roofing</a>: TPO, EPDM, PVC and modified bitumen</li>
          <li><a href="/commercial-roofing/roof-replacement/">Commercial roof replacements</a></li>
          <li><a href="/commercial-roofing/roof-inspection/">Commercial roof inspections</a></li>
          <li><a href="/roof-repair/commercial/">Commercial roof repair</a> and <a href="/roof-repair/emergency-service/">emergency service</a></li>
          <li><a href="/residential-roofing/">Shingle roofs</a> for townhouse communities and HOAs</li>
          <li><a href="/siding-gutter/gutter-installation-repair/">Gutters</a> and <a href="/residential-roofing/skylight-installation-repair/">skylights</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow">
      <div class="section-head"><span class="eyebrow">Common questions</span><h2>Questions from property managers</h2></div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item"><summary><h3>{f.q}</h3></summary><div class="faq-a"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <div class="section-sand"><Reviews limit={3} title="What our customers say" /></div>
  <CtaBand withForm={false} title="Have a building that needs attention?" text="Send us the address, or a list of addresses. We'll inspect, photograph and give you a written proposal for each building." />
</Base>
