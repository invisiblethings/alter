---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Marquee from '../components/ProofStrip.astro';
import Estimator from '../components/Estimator.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { business, telHref } from '../data/business';
import { materials, repairs, skylights, boroughs, range, typicalReplacement, byId } from '../data/costs';
import { reviews, reviewStats, mentions } from '../data/reviews';
import { pageGraph } from '../lib/schema';
import heroImg from '../assets/hero-new-roof.jpg';
import crew from '../assets/crew-on-roof.jpg';

// Homepage: Staten Island homeowners first. Other boroughs have their own pages.
const title = 'Staten Island Roofing Company | Repair & Replacement | Alter Phase Roofing';
const description = 'Family-owned roofing contractor on Staten Island. Roof repair and replacement, most roofs done in 1 day. 5.0★ from 154 reviews. Free inspection.';
const h1 = "Staten Island roofers who'll tell you if a repair is enough";

const asphalt = byId('asphalt');
const si = boroughs[0];
const leak = repairs.find((r) => /leak patch/i.test(r.name)) || repairs[0];
const shingle = repairs.find((r) => /shingle/i.test(r.name)) || repairs[1];
const flash = repairs.find((r) => /flashing/i.test(r.name)) || repairs[3];
const flatLeak = repairs.find((r) => /flat/i.test(r.name)) || repairs[2];
const gutter = repairs.find((r) => /gutter/i.test(r.name)) || repairs[5];
const skyLeak = repairs.find((r) => /skylight/i.test(r.name)) || skylights[0];

const faq = [
  { q: 'How much does a new roof cost on Staten Island?', a: `Most Staten Island roof replacements cost ${range(typicalReplacement.low, typicalReplacement.high)}. Asphalt shingles run about $${asphalt.low}–$${asphalt.high} per square foot installed, so a typical detached house with about 1,800 sq ft of roof lands around ${range(asphalt.low * 1800, asphalt.high * 1800)}. A 1,000 sq ft flat roof is about ${range(si.low, si.high)}. You get an exact, written price after a free inspection.` },
  { q: 'How much does roof repair cost on Staten Island?', a: `Most roof repairs on Staten Island cost ${range(repairs[0].low, 1200)}. A small leak patch is ${range(leak.low, leak.high)}, a shingle repair ${range(shingle.low, shingle.high)} and new flashing ${range(flash.low, flash.high)}. Larger storm or deck repairs can run $1,500–$3,500. The inspection and written estimate are free.` },
  { q: 'How do I choose a roofing company on Staten Island?', a: `Check five things before you sign. Ask for the NYC DCWP Home Improvement Contractor license number and a certificate of insurance. Make sure someone actually climbs your roof and shows you photos, not just drone shots. Get an itemized, written estimate and the warranty terms in writing. Then read the reviews: ${business.name} is license #${business.license.number}, GAF Certified® and rated ${business.rating.value} stars from ${business.rating.count} reviews.` },
  { q: 'Do I need a new roof, or can it be repaired?', a: 'If your roof is under about 15 years old and the damage is in one area, a repair usually makes sense. If it leaks in several places, the shingles are curling or brittle all over, or it is over 20 years old, replacement is usually cheaper in the long run. We show you photos and tell you honestly. Many homeowners who call us about a new roof end up with a repair.' },
  { q: 'How long does a roof replacement take?', a: 'Most Staten Island homes are done in a single day. We tear off the old roof, inspect and repair the deck, install the new system and clean up before we leave.' },
  { q: 'Do I need a permit to replace my roof on Staten Island?', a: 'Not always. Replacing shingles like-for-like usually does not need a NYC DOB permit, but replacing the deck, changing the roof type and some full replacements do. We check this for every job and file the permit for you when it is needed.' },
  { q: 'Will you help with my insurance claim after storm damage?', a: 'Yes. We document the damage with photos and a written report you can send to your insurance company, make emergency repairs to stop further damage, and explain what the permanent repair involves.' },
  { q: 'Are you licensed and insured?', a: `Yes. ${business.name} is a licensed NYC Home Improvement Contractor (DCWP license #${business.license.number}), fully insured, GAF Certified® and BBB accredited.` },
  { q: 'What warranty do I get on a new roof?', a: `Up to ${business.warranty.manufacturerYears} years from the manufacturer on materials and up to ${business.warranty.workmanshipYears} years on our workmanship, in writing.` },
];

const schema = pageGraph({ url: '/', title, description, crumbs: [{ name: 'Home', url: '/' }], kind: 'home', h1, image: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-15.jpg', faq });
const hero = await getImage({ src: heroImg, width: 1024, format: 'webp', quality: 72 });
const band = await getImage({ src: crew, width: 1284, format: 'webp', quality: 62 });
const kt = reviews[0];
// What customers praise most, counted from the published reviews (src/data/reviews.ts).
const quote = (name: string, part: string) => { const r = reviews.find((x) => x.name === name && x.text.includes(part)); if (!r) throw new Error(`Review quote not found: ${name}`); return { q: part, who: `${r.name}, ${r.source}` }; };
const praise = [
  { n: `${mentions('price')}+`, t: 'mention fair, upfront prices', ...quote('Andrey K.', 'The price quoted was the price I paid, no gimmicks. True Staten Islanders.') },
  { n: `${mentions('fast')}+`, t: 'mention fast replies and visits', ...quote('Valerie C.', 'Alter Phase was the only one that returned my call promptly & showed up the next day to give the estimate.') },
  { n: `${mentions('clean')}+`, t: 'mention the cleanup', ...quote('Dee', 'they left the working area cleaner than it was originally.') },
  { n: `${mentions('oneday')}+`, t: 'mention a new roof done in one day', ...quote('Denise L.', 'My entire new roof was done in one day! They left the property spotless.') },
  { n: `${mentions('honest')}+`, t: 'mention honest advice', ...quote('Lisa F.', 'He was honest and did not create a major (expensive) project out of something that was a quick fix.') },
];
const best = quote('Nafis I.', 'Mark is the best roofer I have worked with.');
const climb = quote('Chi C.', 'climbed up the roof to investigate the condition unlike other contractors which were only using a drone to take pictures.');

// "What's going on with your roof?" Each symptom maps to a likely cause, a real price and a next step.
const symptoms = [
  { id: 'stain', icon: 'drop', t: 'Water stain on a ceiling', cause: 'Usually a leak at the flashing around a chimney, vent pipe or skylight, or a worn spot in the shingles. Water travels, so the stain is often several feet from the actual hole.', price: `${range(leak.low, leak.high)} for most small leaks · flashing ${range(flash.low, flash.high)}`, link: '/roof-repair/', cta: 'Roof leak repair' },
  { id: 'shingles', icon: 'roof', t: 'Missing or curling shingles', cause: 'A few missing shingles after a nor\'easter is a quick repair. Shingles curling or cracking all over the roof mean it is near the end of its life, and patching will not hold for long.', price: `${range(shingle.low, shingle.high)} for a shingle repair`, link: '/roof-repair/residential/', cta: 'Shingle repair' },
  { id: 'old', icon: 'calendar', t: 'Roof is 20+ years old', cause: `Asphalt roofs last ${asphalt.life}. A free inspection tells you how many good years are left, so you can plan a replacement instead of reacting to a leak.`, price: `${range(typicalReplacement.low, typicalReplacement.high)} for most Staten Island homes`, link: '/residential-roofing/roof-replacement/', cta: 'Roof replacement' },
  { id: 'flat', icon: 'layers', t: 'Leak on a flat roof or extension', cause: 'Flat roofs over rear extensions, garages and attached homes leak at seams, at the wall flashing and where water ponds. We fix the leak and the drainage that caused it.', price: `${range(flatLeak.low, flatLeak.high)} to repair · new 1,000 sq ft flat roof ${range(si.low, si.high)}`, link: '/flat-roofing/', cta: 'Flat roofing' },
  { id: 'storm', icon: 'bolt', t: 'Storm damage or water coming in', cause: 'Call now, day or night. We stop the water with an emergency tarp or temporary repair, photograph everything for your insurance, then schedule the permanent fix.', price: 'Emergency line answered 24/7', link: '/roof-repair/emergency-service/', cta: 'Emergency roof repair', urgent: true },
  { id: 'sky', icon: 'window', t: 'Leaking skylight or overflowing gutters', cause: 'Skylight leaks are usually failed flashing or seals, not the glass. Overflowing gutters push water behind your fascia and siding, and into the basement.', price: `Skylight leak ${range(skyLeak.low, skyLeak.high)} · gutter repair ${range(gutter.low, gutter.high)}`, link: '/residential-roofing/skylight-installation-repair/', cta: 'Skylights', link2: '/siding-gutter/gutter-installation-repair/', cta2: 'Gutters' },
];

const homes = [
  { t: 'Colonials & capes', d: 'Steep shingle roofs, usually 1,500–2,500 sq ft. Watch the chimney flashing and the sunny south-facing slope, which wears out first.', icon: 'home' },
  { t: 'High-ranch homes', d: 'Low-pitch shingle roofs, often with a flat section over the garage. The joint where flat meets sloped is the classic leak spot.', icon: 'roof' },
  { t: 'Semi-attached & townhouses', d: 'Your roof meets your neighbor\'s. We pay close attention to the seam and flashing at the shared wall, where most of these leaks start.', icon: 'building' },
  { t: 'Homes near the water', d: 'South Beach to Tottenville gets the most wind and salt air. Shingles must be nailed to high-wind specs and flashing must resist corrosion.', icon: 'sun' },
];

const projects = [
  { img: '/wp-content/uploads/2025/05/New-Roof-10314-Staten-Island-NY.jpg', t: 'New architectural shingle roof', w: 'Staten Island, NY 10314' },
  { img: '/wp-content/uploads/2025/04/Replaced-Roof-10305-Staten-Island-10304.jpg', t: 'Full roof replacement', w: 'Staten Island, NY 10305' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-9.jpg', t: 'Tear-off down to the deck', w: 'Staten Island, NY' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-11.jpg', t: 'Flat roof installation', w: 'Staten Island, NY' },
  { img: '/wp-content/uploads/2025/04/New-roof-replacement-in-Staten-Island.jpg', t: 'New roof replacement', w: 'Staten Island, NY' },
];

const shores = [
  { n: 'North Shore', l: ['St. George', 'Stapleton', 'Rosebank', 'Port Richmond', 'West Brighton', 'Westerleigh', 'Castleton Corners'] },
  { n: 'Mid-Island', l: ['Todt Hill', 'Dongan Hills', 'Grant City', 'New Dorp', 'Bulls Head', 'New Springville', 'Travis'] },
  { n: 'East Shore', l: ['South Beach', 'Midland Beach', 'Oakwood', 'Bay Terrace'] },
  { n: 'South Shore', l: ['Great Kills', 'Eltingville', 'Annadale', 'Huguenot', "Prince's Bay", 'Rossville', 'Tottenville'] },
];
---
<Base title={title} description={description} path="/" image="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-15.jpg" imageAlt={`The ${business.name} crew on a Staten Island roof`} schema={schema} preloadImage={hero.src}>
  <section class="hero home">
    <div class="hero-bg"><img src={hero.src} alt="New architectural shingle roof on a Staten Island house in 10305, installed by Alter Phase Roofing Contracting" width="1024" height="1024" fetchpriority="high" decoding="async" /></div>
    <div class="wrap">
      <div>
        <a class="rating-chip" href={business.googleReviewUrl} target="_blank" rel="noopener">
          <span class="g"><Icon name="google" /></span>
          <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          {business.rating.value} · {business.rating.count} reviews
        </a>
        <h1>Staten Island roofers who'll tell you <span class="gold">if a repair is enough.</span></h1>
        <p class="lead">Family-owned roofing contractor on Staten Island for {business.yearsInRoofing}+ years. Free inspection with photos, a written price usually within 24 hours, and the owner on every job. Most new roofs are done in a single day.</p>
        <div class="cta-row" style="margin-top:1.75rem">
          <a class="call-big" href={telHref}>
            <span class="call-ring" aria-hidden="true"><Icon name="phone" /></span>
            <span class="call-txt"><small>Tap to call · free inspection</small><strong>{business.phone}</strong></span>
            <Icon name="arrow" class="call-arrow" />
          </a>
        </div>
        <figure class="hero-quote">
          <blockquote>“Called them thinking I needed a new roof… <strong>turns out the roof was repairable.</strong> They didn't try to pressure me into any unnecessary work.”</blockquote>
          <figcaption><span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span> {kt.name}, Google review</figcaption>
        </figure>
        <ul class="hero-proof">
          <li><img class="gaf-badge gaf-xs" src="/images/gaf-certified.webp" alt="GAF Certified® Residential Roofing Contractor" width="400" height="409" loading="eager" decoding="async" /><span><strong>GAF Certified®</strong> contractor</span></li>
          <li><Icon name="shield" /><span><strong>{business.warranty.manufacturerYears}-yr</strong> warranty</span></li>
          <li><Icon name="license" /><span>Lic. <strong>#{business.license.number}</strong></span></li>
        </ul>
      </div>
      <QuoteWizard id="hero" title="Book your free roof inspection" sub="30 seconds. A real person from our Staten Island office calls you back, usually within the hour." />
    </div>
  </section>

  <Marquee />

  <section class="sec" aria-labelledby="sym-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Roof repair or a new roof?</span><h2 id="sym-h">What's going on with your roof?</h2></div>
        <p class="lead">Pick what you're seeing. We'll tell you what it usually means, what Staten Island homeowners typically pay to fix it, and what to do next.</p>
      </div>
      <div class="sym" data-sym data-reveal>
        <div class="sym-tabs" role="tablist" aria-label="Roof problems">
          {symptoms.map((s, i) => (
            <button type="button" role="tab" id={`sym-t-${s.id}`} aria-controls={`sym-p-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class:list={[s.urgent && 'urgent']}>
              <Icon name={s.icon as any} /><span>{s.t}</span>
            </button>
          ))}
        </div>
        <div class="sym-panels">
          {symptoms.map((s, i) => (
            <div class="sym-panel" role="tabpanel" id={`sym-p-${s.id}`} aria-labelledby={`sym-t-${s.id}`} data-active={i === 0 ? '' : undefined}>
              <h3>{s.t}</h3>
              <p class="sym-k">What it usually means</p>
              <p>{s.cause}</p>
              <p class="sym-k">Typical cost on Staten Island</p>
              <p class="sym-price">{s.price}</p>
              <div class="cta-row">
                {s.urgent
                  ? <a class="btn btn-lg btn-red" href={telHref}><Icon name="phone" /> Call 24/7: {business.phone}</a>
                  : <a class="btn btn-lg" href="#hero-wizard">Book a free inspection <Icon name="arrow" /></a>}
                <a class="link-arrow" href={s.link}>{s.cta} <Icon name="arrow" /></a>
                {s.link2 && <a class="link-arrow" href={s.link2}>{s.cta2} <Icon name="arrow" /></a>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="promise" aria-labelledby="promise-h">
    <div class="wrap promise-grid">
      <div data-reveal>
        <span class="kicker">The repair-first promise</span>
        <h2 id="promise-h">A new roof is a big check. We don't write it for you.</h2>
        <p class="lead">Plenty of roofers walk in wanting to sell a full replacement. We climb up, photograph what we find, and if a repair will do the job, that's what we quote.</p>
      </div>
      <ol class="promise-list" data-reveal data-reveal-d="1">
        <li><Icon name="camera" /><span><strong>Photos of everything we find</strong>You see your roof the way we see it, not a sales pitch.</span></li>
        <li><Icon name="file" /><span><strong>Repair and replacement options, in writing</strong>Itemized prices, usually within 24 hours.</span></li>
        <li><Icon name="roof" /><span><strong>We climb up and look. No drone guesses.</strong>“{climb.q}” <em>{climb.who}</em></span></li>
        <li><Icon name="clock" /><span><strong>No pressure, no "sign today" pricing</strong>Take your time to decide.</span></li>
        <li><Icon name="users" /><span><strong>The owner on every job</strong>Our own crew, never subcontractors.</span></li>
      </ol>
    </div>
  </section>

  <section class="sec" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Everything over your head, one local crew</span><h2 id="svc-h">Roofing services for Staten Island homes</h2></div>
        <p class="lead">Repairs, full replacements, flat roofs, skylights and gutters for Staten Island houses, with real prices up front.</p>
      </div>
      <div class="bento">
        <a class="tile b-a" href="/residential-roofing/roof-replacement/" data-reveal>
          <img src="/wp-content/uploads/2025/05/New-Roof-10314-Staten-Island-NY.jpg" alt="New asphalt shingle roof on a Staten Island house in 10314" width="1024" height="1024" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">Shingles ${asphalt.low}–${asphalt.high} per sq ft</span>
          <h3>Roof replacement</h3>
          <p>Complete tear-off and a new GAF roof, most finished in a single day. Up to {business.warranty.manufacturerYears}-year warranty.</p>
        </a>
        <a class="tile b-b" href="/roof-repair/" data-reveal data-reveal-d="1">
          <img src="/wp-content/uploads/2024/04/AlterPhase-Roof-Repair-Service.jpg" alt="Damaged asphalt shingles with a missing piece, ready for repair" width="520" height="350" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">Most repairs {range(repairs[0].low, 1200)}</span>
          <h3>Roof repair</h3>
          <p>Leaks, shingles, flashing and storm damage, fixed at the source.</p>
        </a>
        <a class="tile b-c" href="/flat-roofing/" data-reveal data-reveal-d="2">
          <img src="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-7.jpg" alt="New white flat roof being installed" width="1284" height="1268" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">From $8 per sq ft</span>
          <h3>Flat roofs</h3>
          <p>Rear extensions, garages, attached homes.</p>
        </a>
        <a class="tile solid t-red b-d" href="/roof-repair/emergency-service/" data-reveal>
          <span class="go"><Icon name="arrow" /></span>
          <Icon name="bolt" class="big-ico" />
          <h3>Emergency roof repair, 24/7</h3>
          <p>Leak or storm damage? We stop the water first, then fix it properly.</p>
          <span class="price" style="margin:1rem 0 0">{business.phone}</span>
        </a>
        <a class="tile b-e" href="/residential-roofing/skylight-installation-repair/" data-reveal data-reveal-d="1">
          <img src="/wp-content/uploads/2024/04/Skylight-Services-Alter-Phase-Roofing.jpg" alt="Skylight installed in a shingle roof" width="503" height="377" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <h3>Skylights</h3>
          <p>Leaks fixed, units replaced.</p>
        </a>
        <a class="tile b-f" href="/siding-gutter/gutter-installation-repair/" data-reveal data-reveal-d="2">
          <img src="/wp-content/uploads/2024/04/Gutter-Services-AlterPhase-768x512.jpg" alt="Seamless gutter installation on a Staten Island home" width="768" height="512" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">Repairs from $150</span>
          <h3>Gutters</h3>
          <p>Seamless gutters, guards and repairs.</p>
        </a>
        <a class="tile b-g" href="/siding-gutter/siding-installation-repair/" data-reveal>
          <img src="/wp-content/uploads/2024/10/Vinyl-Siding-Installation-Staten-Island-1536x797.webp" alt="Vinyl siding installation on a Staten Island home" width="1536" height="797" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <h3>Siding</h3>
          <p>Vinyl and insulated vinyl siding that keeps rain out of your walls.</p>
        </a>
      </div>
      <p class="muted" style="margin:1.25rem 0 0;font-size:0.95rem">Also: <a href="/residential-roofing/roof-inspections/">roof inspections with a photo report</a> · <a href="/services/">all roofing services</a></p>
      <p class="biz-line" data-reveal><Icon name="store" /> <span>Own a business or manage a building? See <a href="/commercial-roofing/">commercial roofing</a> and <a href="/property-managers/">roofing for property managers &amp; HOAs</a>.</span></p>
    </div>
  </section>

  <section class="sec dark" aria-labelledby="cost-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">See your price before anyone climbs a ladder</span><h2 id="cost-h">How much does a new roof cost on Staten Island?</h2></div>
        <p class="lead">Pick your type of house. The range comes from what our Staten Island customers actually paid in {new Date().getFullYear()}. Then we confirm the exact number, free.</p>
      </div>
      <div data-reveal><Estimator /></div>
      <p style="margin-top:1.5rem"><a class="link-arrow" style="color:var(--gold)" href="/roof-replacement-cost-in-nyc/">Full roof cost guide: every material, every borough <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="sec" aria-labelledby="homes-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Local knowledge</span><h2 id="homes-h">We know Staten Island roofs, house by house.</h2></div>
        <p class="lead">From high-ranches in New Springville to colonials on Todt Hill and townhouses in Annadale, every type of home has its own weak spots. We know where to look.</p>
      </div>
      <div class="homes">
        {homes.map((h, i) => (
          <div class="home-card" data-reveal data-reveal-d={String(i % 4)}>
            <span class="home-ico"><Icon name={h.icon as any} /></span>
            <h3>{h.t}</h3>
            <p>{h.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="owner-h">
    <div class="band-bg"><img src={band.src} alt={`The ${business.name} crew on a roof in Staten Island`} width="1284" height="1271" loading="lazy" decoding="async" style="object-position:70% 40%" /></div>
    <div class="wrap">
      <span class="kicker" data-reveal>Family-owned on Staten Island</span>
      <h2 id="owner-h" data-reveal>The owner is on your roof. Every job.</h2>
      <blockquote data-reveal>“I'm part of every job, to make sure the highest quality work is done on every property.”</blockquote>
      <div class="sig" data-reveal><span class="avatar">M</span><span><strong>Marke</strong>Owner, {business.name}</span></div>
      <div class="stats" data-reveal>
        <div class="stat"><b>{business.yearsInRoofing}+</b><span>years in roofing</span></div>
        <div class="stat"><b>{business.warranty.manufacturerYears}<small style="font-size:0.45em"> yr</small></b><span>manufacturer warranty</span></div>
        <div class="stat"><b>{business.warranty.workmanshipYears}<small style="font-size:0.45em"> yr</small></b><span>workmanship warranty</span></div>
        <div class="stat"><b>{business.rating.value}</b><span>stars from {business.rating.count} reviews</span></div>
      </div>
    </div>
  </section>

  <Process />

  <section class="sec praise-sec" id="reviews-sec" aria-labelledby="praise-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">{reviewStats.average} stars · {reviewStats.total} reviews</span><h2 id="praise-h">Why customers call us the best roofers on Staten Island</h2></div>
        <p class="lead">“{best.q}” <span class="muted">{best.who}</span><br />We read all {reviewStats.total} of our reviews ({reviewStats.bySource.Google} on Google, {reviewStats.fiveStar} of them five stars). Here's what keeps coming up.</p>
      </div>
      <div class="praise">
        {praise.map((p, i) => (
          <figure class:list={['praise-card', i === 0 && 'wide']} data-reveal data-reveal-d={String(i % 3)}>
            <p class="praise-n"><b>{p.n}</b> reviews {p.t}</p>
