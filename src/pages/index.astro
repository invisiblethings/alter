---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Marquee from '../components/ProofStrip.astro';
import Estimator from '../components/Estimator.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { business, telHref } from '../data/business';
import { materials, repairs, range, typicalReplacement } from '../data/costs';
import { pageGraph } from '../lib/schema';
import { posts } from '../lib/content';
import heroImg from '../assets/hero-new-roof.jpg';
import crew from '../assets/crew-on-roof.jpg';

const title = 'Staten Island Roofers | Roof Repair & New Roofs | Alter Phase';
const description = 'Family-owned Staten Island roofers: roof repair, replacement and flat roofs with up to 50-year warranties. GAF Master Elite. Free estimates: (929) 370-1552.';
const h1 = 'Staten Island roofers who treat your home like family';

const faq = [
  { q: 'How much does a new roof cost on Staten Island?', a: `Most Staten Island roof replacements cost ${range(typicalReplacement.low, typicalReplacement.high)}+. Asphalt shingles run about $6–$10 per square foot installed and flat roofs about $8–$14. A typical 1,000 sq ft flat roof on Staten Island is $8,000–$13,000. We give you an exact, written price after a free inspection.` },
  { q: 'Do you offer free roof inspections and estimates?', a: 'Yes. We inspect the roof in person, take photos of what we find and give you a written estimate, usually within 24 hours. There is no charge and no obligation.' },
  { q: 'Should I repair or replace my roof?', a: 'If your roof is under about 15 years old and the damage is in one area, a repair usually makes sense. If it leaks in several places, sags, or is over 20 years old, replacement is often cheaper in the long run. We will tell you honestly which one you need, and many of our customers end up with a repair.' },
  { q: 'Do I need a permit to replace my roof in NYC?', a: 'Not always. Replacing the roof covering like-for-like without structural changes usually does not need a DOB permit. Replacing the deck, changing the roof type, commercial buildings and some full replacements do. We check this on every job and file the permit for you when it is needed.' },
  { q: 'Are you licensed and insured?', a: `Yes. Alter Phase Roofing is a licensed NYC Home Improvement Contractor (DCWP license #${business.license.number}), fully insured, GAF Master Elite® certified and BBB accredited.` },
  { q: 'What warranty do you give?', a: `Every roof we install comes with written warranties: up to ${business.warranty.manufacturerYears} years from the manufacturer on materials and up to ${business.warranty.workmanshipYears} years on our workmanship.` },
  { q: 'Do you handle roofing emergencies?', a: `Yes, 24/7. Call ${business.phone}. We stop the water first with emergency tarping or a temporary repair, document the damage for your insurance, then schedule the permanent fix.` },
];

const schema = pageGraph({ url: '/', title, description, crumbs: [{ name: 'Home', url: '/' }], kind: 'home', h1, image: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-15.jpg', faq });
const latest = (await posts()).slice(0, 3);
const shingles = materials.find((m) => m.id === 'asphalt')!;
const hero = await getImage({ src: heroImg, width: 1024, format: 'webp', quality: 72 });
const band = await getImage({ src: crew, width: 1284, format: 'webp', quality: 62 });
const projects = [
  { img: '/wp-content/uploads/2025/05/New-Roof-10314-Staten-Island-NY.jpg', t: 'New architectural shingle roof', w: 'Staten Island, NY 10314' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-9.jpg', t: 'Tear-off down to the deck', w: 'Staten Island, NY' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-7-1.jpg', t: 'TPO flat roof', w: 'Brooklyn, NY' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-14.jpg', t: 'Commercial flat roof', w: 'New York City' },
  { img: '/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-12-1.jpg', t: 'Modified bitumen roof', w: 'Brooklyn, NY' },
];
const si = ['St. George', 'Stapleton', 'Rosebank', 'South Beach', 'Dongan Hills', 'Grant City', 'New Dorp', 'Midland Beach', 'Oakwood', 'Great Kills', 'Eltingville', 'Annadale', 'Huguenot', "Prince's Bay", 'Tottenville', 'Rossville', 'Travis', 'New Springville', 'Bulls Head', 'Westerleigh', 'Port Richmond', 'West Brighton', 'Todt Hill', 'Castleton Corners'];
const areaLinks = [
  { u: '/service-area/staten-island-ny/', n: 'Staten Island', s: 'Home base. Fastest response and most of our work.', tag: 'Home base' },
  { u: '/service-area/brooklyn-ny/', n: 'Brooklyn', s: 'Brownstones, row homes and mixed-use flat roofs.' },
  { u: '/service-area/manhattan-ny/', n: 'Manhattan', s: 'Co-ops, condos and commercial roofs.' },
  { u: '/service-area/queens-ny/', n: 'Queens', s: 'Detached homes and attached rows.' },
];
---
<Base title={title} description={description} path="/" image="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-15.jpg" imageAlt="The Alter Phase Roofing crew on a Staten Island roof" schema={schema} preloadImage={hero.src}>
  <section class="hero home">
    <div class="hero-bg"><img src={hero.src} alt="" width="1024" height="1024" fetchpriority="high" decoding="async" /></div>
    <div class="wrap">
      <div>
        <a class="rating-chip" href={business.googleReviewUrl} target="_blank" rel="noopener">
          <span class="g"><Icon name="google" /></span>
          <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          {business.rating.label} · {business.rating.count} Google reviews
        </a>
        <h1>Staten Island roofers who treat your home <span class="gold">like family.</span></h1>
        <p class="lead">Roof repair, new roofs and flat roofs across Staten Island, Brooklyn, Manhattan and Queens. Family-owned for {business.yearsInRoofing}+ years, and the owner is on every job.</p>
        <div class="cta-row" style="margin-top:2rem">
          <a class="btn btn-lg btn-gold btn-call" href={telHref}><Icon name="phone" /><span><small>Call or text</small>{business.phone}</span></a>
          <a class="btn btn-lg btn-ghost" href="#cost-h">What will it cost? <Icon name="arrow" /></a>
        </div>
        <a class="sos" href="/roof-repair/emergency-service/">
          <span class="pulse"><Icon name="drop" /></span>
          <span><strong>Water coming in right now?</strong>We answer 24/7, tarp it fast and document it for insurance.</span>
        </a>
        <ul class="hero-proof">
          <li><Icon name="award" /><span><strong>GAF Master Elite®</strong> installer</span></li>
          <li><Icon name="shield" /><span><strong>{business.warranty.manufacturerYears}-yr</strong> material warranty</span></li>
          <li><Icon name="license" /><span>Licensed &amp; insured <strong>#{business.license.number}</strong></span></li>
        </ul>
      </div>
      <QuoteWizard id="hero" />
    </div>
  </section>

  <Marquee />

  <section class="sec" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">What we do</span><h2 id="svc-h">Every part of the roof. One local crew.</h2></div>
        <p class="lead">Honest repair-or-replace advice, real prices up front, and the same people from the first inspection to the final walkthrough.</p>
      </div>
      <div class="bento">
        <a class="tile b-a" href="/residential-roofing/roof-replacement/" data-reveal>
          <img src="/wp-content/uploads/2025/05/New-Roof-10314-Staten-Island-NY.jpg" alt="New asphalt shingle roof in Staten Island 10314" width="1024" height="1024" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">Shingles ${shingles.low}–${shingles.high} per sq ft</span>
          <h3>Roof replacement</h3>
          <p>Complete tear-off and a new roof, usually finished in one to two days. Warranty in writing.</p>
        </a>
        <a class="tile b-b" href="/roof-repair/" data-reveal data-reveal-d="1">
          <img src="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-11.jpg" alt="Roofer repairing flashing on a flat roof" width="1284" height="1268" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">Most repairs {range(repairs[0].low, repairs[2].high)}</span>
          <h3>Roof repair</h3>
          <p>Leaks, shingles, flashing and storm damage, fixed at the source.</p>
        </a>
        <a class="tile b-c" href="/flat-roofing/" data-reveal data-reveal-d="2">
          <img src="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-7.jpg" alt="White TPO flat roof being installed" width="1284" height="1268" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <span class="price">From $8 per sq ft</span>
          <h3>Flat roofing</h3>
          <p>TPO, EPDM and modified bitumen for row homes and businesses.</p>
        </a>
        <a class="tile solid t-red b-d" href="/roof-repair/emergency-service/" data-reveal>
          <span class="go"><Icon name="arrow" /></span>
          <Icon name="bolt" class="big-ico" />
          <h3>Emergency roof repair, 24/7</h3>
          <p>Active leak or storm damage? We stop the water first, then fix it properly.</p>
          <span class="price" style="margin:1rem 0 0">{business.phone}</span>
        </a>
        <a class="tile b-e" href="/commercial-roofing/" data-reveal data-reveal-d="1">
          <img src="/wp-content/uploads/2024/04/AlterPhaseRoofingProjects-10.jpg" alt="Roofers sealing a commercial flat roof edge" width="1284" height="1254" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <h3>Commercial roofing</h3>
          <p>Scheduled around your business hours.</p>
        </a>
        <a class="tile b-f" href="/siding-gutter/" data-reveal data-reveal-d="2">
          <img src="/wp-content/uploads/2024/10/Vinyl-Siding-Installation-Staten-Island.webp" alt="Vinyl siding installation in Staten Island" width="1604" height="832" loading="lazy" decoding="async" />
          <span class="go"><Icon name="arrow" /></span>
          <h3>Gutters &amp; siding</h3>
          <p>Seamless gutters and vinyl siding.</p>
        </a>
        <a class="tile solid t-ink b-g" href="/property-managers/" data-reveal>
          <span class="go"><Icon name="arrow" /></span>
          <h3>Managing a building?</h3>
          <p>HOAs, co-op and condo boards, property managers: board-ready proposals, photo reports and insurance certificates.</p>
        </a>
      </div>
      <p class="muted" style="margin:1.5rem 0 0;font-size:0.95rem">Also: <a href="/residential-roofing/skylight-installation-repair/">skylight repair &amp; installation</a> · <a href="/residential-roofing/roof-inspections/">roof inspections</a> · <a href="/services/">all services</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="owner-h">
    <div class="band-bg"><img src={band.src} alt="The Alter Phase Roofing crew on a roof in Staten Island" width="1284" height="1271" loading="lazy" decoding="async" style="object-position:70% 40%" /></div>
    <div class="wrap">
      <span class="kicker" data-reveal>Our promise</span>
      <h2 id="owner-h" data-reveal>The owner is on your roof. Every job.</h2>
      <blockquote data-reveal>“I'm part of every job, to make sure the highest quality work is done on every property.”</blockquote>
      <div class="sig" data-reveal><span class="avatar">M</span><span><strong>Marke</strong>Owner, Alter Phase Roofing</span></div>
      <div class="stats" data-reveal>
        <div class="stat"><b>{business.yearsInRoofing}+</b><span>years in roofing, family-owned</span></div>
        <div class="stat"><b>{business.warranty.manufacturerYears}<small style="font-size:0.45em"> yr</small></b><span>manufacturer material warranty</span></div>
        <div class="stat"><b>{business.warranty.workmanshipYears}<small style="font-size:0.45em"> yr</small></b><span>workmanship warranty, in writing</span></div>
        <div class="stat"><b>24/7</b><span>emergency response</span></div>
      </div>
    </div>
  </section>

  <section class="sec dark" aria-labelledby="cost-h" style="scroll-margin-top:var(--head)">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Real prices, not "call for a quote"</span><h2 id="cost-h">What will your roof cost?</h2></div>
        <p class="lead">Our actual {new Date().getFullYear()} New York City job averages. Pick your roof and see a range in seconds, then get the exact number with a free inspection.</p>
      </div>
      <div data-reveal><Estimator /></div>
      <p style="margin-top:1.5rem"><a class="link-arrow" style="color:var(--gold)" href="/roof-replacement-cost-in-nyc/">Read the full NYC roof cost guide <Icon name="arrow" /></a></p>
    </div>
  </section>

  <Process />

  <div id="reviews-sec"><Reviews limit={4} /></div>

  <section class="sec" aria-labelledby="proj-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Recent work</span><h2 id="proj-h">Real roofs. Real neighborhoods.</h2></div>
        <p class="lead">Every photo here is our own crew on our own jobs. No stock photos, ever.</p>
      </div>
      <div class="mosaic">
        {projects.map((p, i) => (
          <figure data-reveal data-reveal-d={String(i % 3)}>
            <img src={p.img} alt={`${p.t} in ${p.w} by Alter Phase Roofing`} width="1024" height="1024" loading="lazy" decoding="async" />
            <figcaption><h3>{p.t}</h3>{p.w}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dark" aria-labelledby="area-h">
    <div class="wrap grid-2" style="align-items:start">
      <div data-reveal>
        <span class="kicker">Where we work</span>
        <h2 id="area-h">Based on Staten Island. Working across New York City.</h2>
        <p class="lead">Our shop is at {business.address.street}, Staten Island. That's where most of our work is, and we do a lot in Brooklyn, Manhattan and Queens too.</p>
        <p style="font-weight:800;color:#fff;margin:2rem 0 0.8rem">Staten Island neighborhoods we serve</p>
        <div class="chips">{si.map((n) => <span>{n}</span>)}</div>
      </div>
      <ul class="boroughs" data-reveal data-reveal-d="1">
        {areaLinks.map((a) => (
          <li><a href={a.u}><span><b>{a.n}{a.tag && <span class="tag">{a.tag}</span>}</b><small>{a.s}</small></span><Icon name="arrow" /></a></li>
        ))}
        <li><a href="/service-area/"><span><b style="font-size:1.4rem">All service areas</b></span><Icon name="arrow" /></a></li>
      </ul>
    </div>
  </section>

  <section class="sec bone">
    <div class="wrap faq-split">
      <div data-reveal>
        <span class="kicker">FAQ</span>
        <h2>Roofing questions we hear every day</h2>
        <p class="lead">Still unsure? Ask the people who'll do the work.</p>
        <a class="btn btn-lg" href={telHref}><Icon name="phone" /> {business.phone}</a>
      </div>
      <div data-reveal data-reveal-d="1"><Faq items={faq} title="Roofing questions and answers" bare /></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="guides-h">
    <div class="wrap">
      <div class="head-split" data-reveal>
        <div><span class="kicker">Homeowner guides</span><h2 id="guides-h">Know the facts before you hire anyone.</h2></div>
        <p><a class="btn btn-line" href="/blog/">All guides <Icon name="arrow" /></a></p>
      </div>
      <div class="grid-3">
        {latest.map((p, i) => (
          <a class="post-card" href={p.data.path} data-reveal data-reveal-d={String(i)}>
            <div class="img">{p.data.image && <img src={p.data.image} alt={p.data.imageAlt || ''} width="640" height="400" loading="lazy" decoding="async" />}</div>
            <span class="meta">Guide</span><h3>{p.data.cardTitle || p.data.h1}</h3><p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCta />
</Base>
