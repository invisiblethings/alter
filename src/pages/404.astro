---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Skyline from '../components/Skyline.astro';
import { business, telHref } from '../data/business';
import { services, areas } from '../data/nav';
---
<Base title="Page not found | Alter Phase Roofing" description="" path="/404/" noindex>
  <section class="page-hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:760px">
        <span class="eyebrow" style="color:var(--gold-400)">404</span>
        <h1>This page has moved or no longer exists.</h1>
        <p class="lead">Sorry about that. Here are the pages people look for most, or just give us a call.</p>
        <div class="hero-actions">
          <a class="btn btn-gold btn-lg" href={telHref}><Icon name="phone" /> Call {business.phone}</a>
          <a class="btn btn-ghost-light btn-lg" href="/">Go to the homepage</a>
        </div>
      </div>
    </div>
    <Skyline />
  </section>
  <section class="section">
    <div class="wrap split" style="align-items:start">
      <div><h2>Services</h2><ul>{services.map((s) => <li><a href={s.url}>{s.title}</a></li>)}</ul></div>
      <div><h2>Service areas</h2><ul>{areas.map((a) => <li><a href={a.url}>{a.title}</a></li>)}</ul><p><a href="/blog/">Roofing guides &amp; costs</a></p></div>
    </div>
  </section>
</Base>
