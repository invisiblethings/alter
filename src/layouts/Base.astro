---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import AddressAutocomplete from '../components/AddressAutocomplete.astro';
import fontUrl from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import { business, SITE } from '../data/business';

interface Props {
  title: string;
  description?: string;
  path: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'article';
  published?: string;
  modified?: string;
  schema?: object;
  preloadImage?: string;
  /** Ads landing pages: no site header, menu or footer. */
  bare?: boolean;
}
const { title, description = '', path, image, imageAlt, noindex = false, canonical, ogType = 'website', published, modified, schema, preloadImage, bare = false } = Astro.props;
const canonicalUrl = SITE + (canonical || path);
const ogImage = SITE + (image || '/wp-content/uploads/2024/04/AlterPhaseRoofingOpenGraph.jpg');
// Same robots policy the old site sent (Rank Math defaults), minus WordPress noise.
const robots = noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large';
---
<!doctype html>
<html lang="en-US" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    {path !== '/404/' && !noindex && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Alter Phase Roofing Contracting: roofing guides" href="/rss.xml" />
    <meta name="theme-color" content="#08214a" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="format-detection" content="telephone=no" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>

    <!-- Google Tag Manager: GA4 G-KKQEPJ782W + Google Ads AW-397936435 (call & click conversions).
         Loaded after the page is interactive (first tap/scroll/key, or 3 s after load) so the
         tags don't slow phones down. Events pushed before that (phone clicks, form leads) wait
         in dataLayer and GTM processes them when it starts. -->
    <script is:inline define:vars={{ gtmId: business.gtmId }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      (function () {
        var done = false, evs = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
        function load() {
          if (done) return; done = true;
          evs.forEach(function (e) { removeEventListener(e, load, true); });
          var j = document.createElement('script'); j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          document.head.appendChild(j);
        }
        evs.forEach(function (e) { addEventListener(e, load, { capture: true, passive: true, once: true }); });
        addEventListener('load', function () { setTimeout(load, 3000); });
        // Every call button reports a phone_click event (GTM trigger: Custom Event "phone_click"),
        // which still counts when the tap happens before GTM has loaded.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="tel:"]');
          if (a) window.dataLayer.push({ event: 'phone_click', phone_number: a.getAttribute('href').slice(4), link_text: (a.textContent || '').trim().slice(0, 60), page_path: location.pathname });
        }, true);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${business.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header path={path} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <CallBar quoteHref={bare ? '#lp-wizard' : undefined} />
    <AddressAutocomplete />
    <script is:inline>
      // Google Ads call tracking: the Google tag (via GTM) swaps the visible
      // number for a Google forwarding number for ad visitors. It can only
      // rewrite text it can see, so when the reference number changes we point
      // every call button (icons, "Call now", the mobile bar) at the new number.
      (function () {
        var ref = document.querySelector('[data-call-ref]');
        if (!ref || !window.MutationObserver) return;
        var digits = function () { var d = ref.textContent.replace(/\D/g, ''); return d.slice(-10); };
        var start = digits();
        var obs = new MutationObserver(function () {
          var now = digits();
          if (now.length !== 10 || now === start) return;
          document.querySelectorAll('a[href^="tel:"]').forEach(function (a) { a.href = 'tel:+1' + now; });
          obs.disconnect();
        });
        obs.observe(ref, { subtree: true, childList: true, characterData: true });
      })();
    </script>
    <script>
      // Scroll reveal: progressive enhancement only; CSS keeps content visible without JS or with reduced motion.
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
